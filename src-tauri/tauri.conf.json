{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRes",
  "identifier": "io.github.gxnza48.vres",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VRes",
        "url": "index.html",
        "width": 1120,
        "height": 720,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "create": false,
        "title": "VRes",
        "url": "quick.html",
        "width": 360,
        "height": 440,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PENDING_UPDATER_PUBKEY",
      "endpoints": [
        "https://github.com/Gxnza48/VRes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "VRes",
    "homepage": "https://github.com/Gxnza48/VRes",
    "copyright": "© 2026 VRes contributors · GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Ajustes de pantalla para gaming",
    "longDescription": "VRes ajusta cómo tu monitor muestra la imagen: saturación, vibrance, resolución estirada y crosshair. Gratis, local y de código abierto.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SpanishInternational", "English", "PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
